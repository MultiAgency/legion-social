# near-social-server configuration (all optional unless noted)

CHAIN_ID=mainnet
# The receiver all social writes go to. Use a staging receiver (e.g. social-staging) for development.
SOCIAL_ACCOUNT_ID=social
# REQUIRED on first start (no checkpoint yet): the launch block height, or `latest` for development.
START_BLOCK_HEIGHT=latest
# `off` serves an existing event log without tailing new blocks (demo data, debugging).
INDEXER=on
NUM_THREADS=8
# neardata auth token (lifts public rate limits; recommended for backfills)
FASTNEAR_AUTH_BEARER_TOKEN=
BLOCK_UPDATE_INTERVAL_MS=5000

# Event log + checkpoint location. Back this directory up: it is the only state.
DATA_DIR=./data
BIND=127.0.0.1
PORT=3040
# Public base URL of this API (substituted into /skill.md, /standard.md, /api.md)
PUBLIC_URL=http://127.0.0.1:3040

RPC_URL=https://rpc.mainnet.fastnear.com
FASTFS_GATEWAY=https://main.fastfs.io

# Legacy near.social (SocialDB) migration sources
LEGACY_API_URL=https://api.near.social
LEGACY_CONTRACT=social.near
# First gateway is the near.social IPFS mirror (tried first; requires a Referer).
IPFS_GATEWAYS=https://ipfs.near.social,https://ipfs.io,https://dweb.link
LEGACY_REFERER=https://near.social/
# Last-resort fallback: serves resized re-encodes (not originals) from its cache.
LEGACY_IMAGE_PROXY=https://i.near.social
# Account-avatar resolver used as a last resort for NFT avatars (200 = image URL, 203 = default avatar).
LEGACY_MAGIC_URL=https://near.social/magic/img/account
# Legacy image fetch timeouts: the mirror may need time to pull unpinned content.
LEGACY_MIRROR_TIMEOUT_SECS=30
LEGACY_FETCH_TIMEOUT_SECS=8
LEGACY_IMAGE_BUDGET_SECS=45

# Optional: file with one account id per line to hide from feeds (reloaded on change)
DENYLIST_PATH=

# NEAR Legion (docs/LEGION.md). Unset: the server behaves like upstream near.social.
# LEGION_CONTRACTS=initiate=initiate.nearlegion.near,ascendant=ascendant.nearlegion.near,vanguard=vanguard.nearlegion.near
# Recheck every account's membership this often (default 3600).
# LEGION_REFRESH_SECS=3600
# The Legion feed account: posts sent to it are members only (default legion). It must equal the
# web's NEXT_PUBLIC_LEGION_FEED.
# LEGION_FEED=legion
# The NearBuilders API the Builders feed reads its members from (default below).
# NEARBUILDERS_API=https://nearbuilders.org/api

RUST_LOG=info

# Link previews: this site's hostnames (links to them aren't previewed; post links become quotes),
# preview fetching on/off, and where near.fm song metadata comes from.
SITE_HOSTS=near.social,www.near.social
UNFURL=on
#UNFURL_USER_AGENT=Mozilla/5.0 (compatible; NearSocialBot/1.0; +https://near.social)
NEAR_FM_API_URL=https://api.near.fm
