# Public read API (the Rust server in ../server). Used by the browser.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3040
# Base URL for server-side fetches (SSR, route handlers). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=http://127.0.0.1:3040
# NEAR network and the receiver account every social-kv/1 write goes to.
NEXT_PUBLIC_NETWORK_ID=mainnet
NEXT_PUBLIC_SOCIAL_ACCOUNT_ID=social
# JSON-RPC endpoint used to sign/send transactions and read access keys.
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.fastnear.com
# FastFS gateway that serves uploaded media.
NEXT_PUBLIC_FASTFS_GATEWAY=https://main.fastfs.io
# Allowance (in NEAR) of the app-held function-call key added on "Enable posting".
NEXT_PUBLIC_KEY_ALLOWANCE_NEAR=1
# Where old near.social URLs (/{account}/widget/…, /embed, /edit, /signin) redirect and /magic/… is
# proxied to. Read at build time.
LEGACY_NEAR_SOCIAL_URL=https://legacy.near.social
# Optional: absolute public URL of this app (used for OpenGraph metadata).
# NEXT_PUBLIC_SITE_URL=https://near.social

# The site's name in titles, the wordmark and copy (default near.social), e.g. "MultiSocial".
NEXT_PUBLIC_SITE_NAME=

# The one-line pitch on the home page and in page descriptions (default upstream's), e.g.
# "The social network for NEAR Legion members."
NEXT_PUBLIC_SITE_TAGLINE=

# The Legion feed account (docs/LEGION.md §3). Set, the composer offers "Legion only" and home gets
# a Legion tab; unset, neither shows.
NEXT_PUBLIC_LEGION_FEED=

# The site mark: "legion" for the Legion knot (default upstream's near.social mark).
NEXT_PUBLIC_SITE_MARK=
