[Unit]
Description=near.social web app (Next.js)
Wants=network-online.target
After=network-online.target near-social-server.service

[Service]
Type=simple
User=nearsocial
Group=nearsocial
EnvironmentFile=/etc/near-social/web.env
Environment=NODE_ENV=production PORT=3000 HOSTNAME=127.0.0.1 NEXT_TELEMETRY_DISABLED=1
# /opt/near-social/web is a symlink to the current release (deploy/deploy.sh).
WorkingDirectory=/opt/near-social/web
# Adjust if node isn't in /usr/bin (e.g. installed with nvm).
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
TimeoutStopSec=15
# next/image's optimized-image cache; each release links .next/cache here.
CacheDirectory=near-social-web

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/cache/near-social-web

[Install]
WantedBy=multi-user.target
