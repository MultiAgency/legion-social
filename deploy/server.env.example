# /etc/near-social/server.env — near-social-server (API + indexer). Mode 640, root:nearsocial.
# All options: server/.env.example.

CHAIN_ID=mainnet
SOCIAL_ACCOUNT_ID=social
# First start only (no checkpoint yet in DATA_DIR): the block to index from. 217836400 is just
# before the first social-kv/1 writes; later starts resume from the checkpoint.
START_BLOCK_HEIGHT=217836400
INDEXER=on
NUM_THREADS=8
# FastNEAR API key (neardata rate limits).
FASTNEAR_AUTH_BEARER_TOKEN=

# The event log + checkpoint: the server's only state. Back it up (see deploy/README.md).
DATA_DIR=/var/lib/near-social/data
BIND=127.0.0.1
PORT=3040
# Public URL of the API (used in /skill.md, /standard.md, /api.md).
PUBLIC_URL=https://api2.near.social

# Optional: one account id per line to hide from feeds (reloaded when it changes).
#DENYLIST_PATH=/etc/near-social/denylist.txt

RUST_LOG=info
