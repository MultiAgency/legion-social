# /etc/near-social/web.env — the Next.js app. Mode 644 (no secrets).
# NEXT_PUBLIC_* and LEGACY_NEAR_SOCIAL_URL are compiled in at build time (deploy/deploy.sh
# sources this file before `npm run build`), so rebuild after changing them.

# Public API origin, called by browsers (also allowed in the CSP).
NEXT_PUBLIC_API_URL=https://api2.near.social
# This site's public origin (OpenGraph metadata).
NEXT_PUBLIC_SITE_URL=https://near.social
NEXT_PUBLIC_NETWORK_ID=mainnet
NEXT_PUBLIC_SOCIAL_ACCOUNT_ID=social
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.fastnear.com
NEXT_PUBLIC_FASTFS_GATEWAY=https://main.fastfs.io
NEXT_PUBLIC_KEY_ALLOWANCE_NEAR=1
LEGACY_NEAR_SOCIAL_URL=https://legacy.near.social

# Runtime: server-side rendering talks to the API directly on localhost (match server.env PORT).
API_INTERNAL_URL=http://127.0.0.1:3040
# Port the web app listens on (on 127.0.0.1). If you change it, also change the near_social_web
# upstream in the nginx config.
PORT=3030
